# Straight Salon — environment template.
# Create `.env` (git-ignored) with `npm run env:init`: it copies this file and generates the
# secrets below. Then adjust as needed. Every variable is validated at startup
# (backend: src/config/env.ts). Specs: 03-backend §3, 05-frontend §8, 11-docker §2.
#
# URLs below target "apps on the host, infra in Docker" mode. docker-compose.yml
# overrides MONGO_URI / REDIS_URL / SMTP_HOST / API_INTERNAL_URL with service names.

# ---------- Backend: runtime ----------
NODE_ENV=development
PORT=4000
APP_VERSION=0.0.0-dev
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Backend: logging ----------
LOG_LEVEL=info
LOG_PRETTY=true

# ---------- Backend: data stores (Phase 1+) ----------
# directConnection=true is required from the host because the replica-set member is "mongo:27017"
MONGO_URI=mongodb://localhost:27017/straight_salon?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Optional Mongo auth mode (docker-compose.auth.yml). Default local dev runs without auth.
# Use URL-safe passwords (letters/digits), as they are embedded in the Mongo URI.
MONGO_AUTH=false
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# ---------- SonarQube (docker-compose.sonar.yml, Phase 11) ----------
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# ---------- Backend: auth (Phase 3+) ----------
# Generated by `npm run env:init`.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=straight-salon-api
JWT_AUDIENCE=straight-salon-web
REFRESH_TOKEN_TTL_DAYS=7
# Empty = host-only cookies (recommended; browsers reject Domain=localhost).
COOKIE_DOMAIN=
COOKIE_SECURE=false
BCRYPT_COST=12
# Apply pending migrations at API start (default: on outside production).
MIGRATE_ON_START=true

# ---------- Backend: cache & rate limiting (Phase 2+) ----------
CACHE_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------- Backend: notifications (Phase 6+) ----------
# mock = store in the `notifications` collection and log (no delivery); smtp = send through
# SMTP_* (Mailpit locally: http://localhost:8025). docker-compose.yml uses smtp.
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_FROM=Straight Salon <no-reply@straightsalon.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ---------- Backend: events (Phase 2+) ----------
RUN_RELAY_IN_WORKER=true
# 32 random bytes, base64. Required by backend/worker. Generated by `npm run env:init`.
OUTBOX_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---------- Backend: uploads (Phase 4+) ----------
# Local ObjectStorage adapter (API-027): images are written to UPLOADS_DIR (relative to
# backend/) and served by the API at /uploads. UPLOADS_PUBLIC_URL is the browser-facing URL
# of that path and is stored in services.imageUrl / staff.photoUrl.
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_URL=http://localhost:4000/uploads

# ---------- Backend: ops ----------
SWAGGER_ENABLED=true
METRICS_ENABLED=true
# Bull Board at http://localhost:4000/admin/queues (ADMIN email + password, HTTP Basic).
# Default: on outside production.
BULL_BOARD_ENABLED=true

# ---------- Frontend ----------
NEXT_PUBLIC_APP_NAME=Straight Salon
NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_INTERNAL_URL=http://localhost:4000
