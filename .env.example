# Straight Salon — environment template.
# Copy to `.env` (git-ignored) and adjust. Every variable is validated at startup
# (backend: src/config/env.ts). Specs: 03-backend §3, 05-frontend §8, 11-docker §2.
#
# URLs below target "apps on the host, infra in Docker" mode. docker-compose.yml
# overrides MONGO_URI / REDIS_URL / SMTP_HOST / API_INTERNAL_URL with service names.

# ---------- Backend: runtime ----------
NODE_ENV=development
PORT=4000
APP_VERSION=0.0.0-dev
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Backend: logging ----------
LOG_LEVEL=info
LOG_PRETTY=true

# ---------- Backend: data stores (Phase 1+) ----------
# directConnection=true is required from the host because the replica-set member is "mongo:27017"
MONGO_URI=mongodb://localhost:27017/straight_salon?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
MONGO_AUTH=false

# ---------- Backend: auth (Phase 3+) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=straight-salon-api
JWT_AUDIENCE=straight-salon-web
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_COST=12

# ---------- Backend: cache & rate limiting (Phase 2+) ----------
CACHE_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------- Backend: notifications (Phase 6+) ----------
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ---------- Backend: events (Phase 2+) ----------
RUN_RELAY_IN_WORKER=true
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OUTBOX_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---------- Backend: ops ----------
SWAGGER_ENABLED=true
METRICS_ENABLED=true

# ---------- Frontend ----------
NEXT_PUBLIC_APP_NAME=Straight Salon
NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_INTERNAL_URL=http://localhost:4000
