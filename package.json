{
  "name": "straight-salon",
  "version": "0.0.0",
  "private": true,
  "description": "Salon appointment booking and management platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently --names backend,worker,frontend --prefix-colors blue,yellow,magenta \"npm run dev -w backend\" \"npm run dev:worker -w backend\" \"npm run dev -w frontend\"",
    "env:init": "node scripts/init-env.mjs",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f backend worker",
    "seed": "docker compose exec backend npm run db:seed",
    "tools": "docker compose --profile tools up -d",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "npm run test:e2e -w frontend",
    "openapi:export": "npm run openapi:export -w backend",
    "api:client": "npm run api:client -w frontend",
    "contract:check": "node scripts/contract-check.mjs",
    "audit": "node scripts/audit.mjs",
    "sonar": "node --env-file-if-exists=.env scripts/sonar.mjs",
    "sonar:setup": "node --env-file-if-exists=.env scripts/sonar-setup.mjs",
    "db:seed": "npm run db:seed -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "stats:rebuild": "npm run stats:rebuild -w backend --",
    "queues:retry-failed": "npm run queues:retry-failed -w backend --",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run contract:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "mongodb-memory-server": false,
    "@scarf/scarf": false,
    "msgpackr-extract": false,
    "bcrypt": false,
    "msw": false
  }
}
