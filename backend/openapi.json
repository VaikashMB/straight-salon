{
  "openapi": "3.1.0",
  "info": {
    "title": "Straight Salon API",
    "version": "0.0.0",
    "description": "Salon booking and management API. Errors use RFC 7807 problem details; every response carries X-Request-Id."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ss_rt"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://straightsalon.dev/errors/slot-unavailable"
          },
          "title": {
            "type": "string",
            "example": "Conflict"
          },
          "status": {
            "type": "integer",
            "example": 409
          },
          "code": {
            "type": "string",
            "example": "SLOT_UNAVAILABLE"
          },
          "detail": {
            "type": "string",
            "example": "The selected stylist is no longer free at 11:00."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/bookings"
          },
          "requestId": {
            "type": "string",
            "example": "6f1c2a8e-4d1b-4c0e-9a57-2b8f0e1d3c4a"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "example": "startAt"
                },
                "message": {
                  "type": "string",
                  "example": "Invalid ISO datetime"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "instance"
        ],
        "description": "RFC 7807 problem details (03-backend §4)"
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer",
            "example": 50000,
            "description": "Smallest currency unit"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "example": "INR",
            "description": "ISO 4217"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ],
        "example": {
          "page": 1,
          "pageSize": 20,
          "total": 134,
          "totalPages": 7
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "CUSTOMER",
          "STAFF",
          "RECEPTIONIST",
          "ADMIN"
        ],
        "example": "CUSTOMER"
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$/i",
            "example": "6712c0f9a1b2c3d4e5f60789"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "isActive": {
            "type": "boolean"
          },
          "isWalkIn": {
            "type": "boolean"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "preferredStaffId": {
                "type": "string",
                "pattern": "^[a-f\\d]{24}$/i",
                "example": "6712c0f9a1b2c3d4e5f60789"
              },
              "smsOptIn": {
                "type": "boolean"
              },
              "emailOptIn": {
                "type": "boolean"
              }
            },
            "required": [
              "smsOptIn",
              "emailOptIn"
            ]
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "role",
          "isActive",
          "isWalkIn",
          "preferences",
          "createdAt",
          "updatedAt"
        ],
        "example": {
          "id": "6712c0f9a1b2c3d4e5f60111",
          "name": "Ananya R",
          "email": "ananya@example.com",
          "phone": "+919876543212",
          "role": "CUSTOMER",
          "isActive": true,
          "isWalkIn": false,
          "preferences": {
            "smsOptIn": true,
            "emailOptIn": true
          },
          "createdAt": "2026-10-06T09:12:44.000Z",
          "updatedAt": "2026-10-06T09:12:44.000Z"
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "total",
              "totalPages"
            ],
            "example": {
              "page": 1,
              "pageSize": 20,
              "total": 134,
              "totalPages": 7
            }
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT, 15 minutes. Keep in memory only (05 §5)."
          }
        },
        "required": [
          "user",
          "accessToken"
        ]
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "example": {
          "status": "ok"
        }
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "error",
              "shutting_down"
            ],
            "description": "ok: all up. degraded: a non-critical dependency (Redis) is down, still serving (HTTP 200). error: a critical dependency (MongoDB) is down (HTTP 503). shutting_down: draining (HTTP 503)."
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down"
                  ]
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Liveness probe",
        "description": "The process is up. No dependency checks (03-backend §6).",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Readiness probe",
        "description": "Pings MongoDB (critical) and Redis (non-critical). Returns 503 if MongoDB is down or the process is shutting down; Redis down only degrades the status (03-backend §6).",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready (status ok or degraded)",
            "content": {
              "application/json": {
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "checks": {
                        "mongo": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "up"
                        }
                      }
                    }
                  },
                  "degraded": {
                    "value": {
                      "status": "degraded",
                      "checks": {
                        "mongo": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down"
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready (MongoDB down or shutting down)",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "checks": {
                    "mongo": {
                      "status": "down"
                    },
                    "redis": {
                      "status": "up"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Prometheus metrics",
        "description": "Exposed when METRICS_ENABLED=true (03-backend §6).",
        "security": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "http_request_duration_seconds_bucket{...} 3"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a customer account (API-001)",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80,
                    "example": "Ananya R"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "ananya@example.com"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9]\\d{7,14}$",
                    "example": "+919876543212"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "format": "password",
                    "example": "Fade-and-Trim7"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "phone",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered and signed in",
            "headers": {
              "Set-Cookie": {
                "description": "ss_rt (httpOnly, Path=/api/v1/auth) and ss_session",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Email or phone already registered (DUPLICATE, PHONE_ALREADY_REGISTERED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in (API-002)",
        "description": "5 failed attempts for one email lock it for 15 minutes (429).",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "ananya@example.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "format": "password",
                    "example": "Fade-and-Trim7"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "Set-Cookie": {
                "description": "ss_rt (httpOnly, Path=/api/v1/auth) and ss_session",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password (UNAUTHENTICATED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate the refresh token (API-003)",
        "description": "Reusing a rotated token revokes every session of that login (06 §2).",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "New access token; new refresh cookie",
            "headers": {
              "Set-Cookie": {
                "description": "ss_rt (httpOnly, Path=/api/v1/auth) and ss_session",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or reused refresh token (UNAUTHENTICATED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out of this device (API-004)",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "responses": {
          "204": {
            "description": "Session ended; cookies cleared"
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out of all devices (API-005)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "responses": {
          "204": {
            "description": "All sessions ended"
          },
          "401": {
            "description": "Not authenticated (UNAUTHENTICATED, TOKEN_EXPIRED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Request a password reset email (API-006)",
        "description": "Always 202, whether or not the email has an account (no user enumeration).",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "ananya@example.com"
                  }
                },
                "required": [
                  "email"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set a new password with a reset token (API-007)",
        "description": "Ends every session of the account.",
        "security": [],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200,
                    "description": "From the emailed reset link"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8,
                    "format": "password",
                    "example": "Fade-and-Trim7"
                  }
                },
                "required": [
                  "token",
                  "newPassword"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Invalid input, or invalid/expired/used token (VALIDATION_FAILED, INVALID_RESET_TOKEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
