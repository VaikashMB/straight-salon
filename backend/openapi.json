    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change password (API-008)",
        "description": "Ends every other session; this device receives a fresh refresh cookie.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "straight-salon-web"
              ],
              "description": "CSRF guard for auth endpoints (06 §4)"
            },
            "required": true,
            "description": "CSRF guard for auth endpoints (06 §4)",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "format": "password"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8,
                    "format": "password",
                    "example": "Fade-and-Trim7"
                  }
                },
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed",
            "headers": {
              "Set-Cookie": {
                "description": "ss_rt (httpOnly, Path=/api/v1/auth) and ss_session",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or current password incorrect (VALIDATION_FAILED)",
